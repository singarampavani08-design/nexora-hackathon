# Nexora — Supabase configuration (copy to .env and fill in)
# Copy this file to .env and fill in real values. Never commit .env.

# Supabase project URL (Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon/publishable key — safe to expose in the browser (RLS protects data).
# NEVER put the service_role/secret key in frontend code or env files that are committed.
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Zoom Server-to-Server OAuth — SERVER-SIDE ONLY (no VITE_ prefix, never exposed to the browser).
# Create at: Zoom Marketplace → Develop → Build App → Server-to-Server OAuth.
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_WEBHOOK_SECRET_TOKEN=your-zoom-webhook-secret-token

# Hindsight (agent memory) — server-side only. Used by the memory brick.
HINDSIGHT_API_KEY=your-hindsight-api-key
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=NEXORA
